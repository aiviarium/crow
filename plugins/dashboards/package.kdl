format 1

package {
  group crow
  id dashboards
  version "0.1.0"
}

about {
  name "Dashboards"
  summary "Pages of widgets on a grid, in a person's own space or shared with a team space."
  license MIT
  license Apache-2.0
  repository "https://github.com/aiviarium/crow"
  keywords rookery-plugin
}

targets {
  rookery {
    requires {
      rookery ">=0.6"
    }
  }
}
