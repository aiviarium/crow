format 1

package {
  group crow
  id code
  version "0.1.0"
}

about {
  name "GitHub"
  summary "GitHub in Crow: repositories, pull requests, issues, reviews and merges, with webhooks, notifications and agent tools."
  license MIT
  license Apache-2.0
  repository "https://github.com/aiviarium/crow"
  keywords rookery-plugin
}

targets {
  rookery {
    requires {
      rookery ">=0.6"
    }
  }
}
