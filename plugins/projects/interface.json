        "searchIssues": {
          "description": "Issues matching a query in the filter language, newest first.",
          "params": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "project": {
                "type": "string",
                "description": "Project key or space id; the current project by default"
