                  "type": "string"
                },
                "repository": {
                  "type": "string"
                },
                "name": {
                  "description": "The repository's name at the source",
                  "type": ["string", "null"]
                },
                "repoSpace": {
                  "type": ["string", "null"]
                },
                "key": {
                  "description": "The project's key",
                  "type": ["string", "null"]
                }
              },
              "required": ["id", "space", "provider", "repository", "key"],
              "additionalProperties": {}
