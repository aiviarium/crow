        "link": {
          "description": "Links an issue to another issue (a relation) or to any entity (a reference).",
          "params": {
            "type": "object",
            "properties": {
              "issue": {
                "type": "string",
                "description": "Key (CROW-12) or URI (issue://…)"
              },
              "entity": {
                "type": "string",
                "description": "An issue key, or any entity's URI"
              },
              "kind": {
                "type": "string",
                "enum": ["blocks", "relates", "duplicate"]
              }
            },
            "required": ["issue", "entity"]
          },
          "result": {
            "type": "object",
            "properties": {
              "linked": {
                "type": "boolean"
              }
            },
            "required": ["linked"]
          }
        },
        "resolveKeys": {
          "description": "For GitHub's link patterns: issue keys to issue URIs, null for keys that are not issues.",
          "params": {
            "type": "object",
            "properties": {
              "keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "space": {
                "type": "string"
              }
            },
            "additionalProperties": {}
          },
          "result": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": ["string", "null"]
            }
          }
        },
        "issueText": {
          "description": "The text of an issue for an agent or a model; null when there is no such issue.",
          "params": {
            "type": "object",
            "properties": {
              "issue": {
                "type": "string",
                "description": "Key (CROW-12) or URI (issue://…)"
              }
            },
            "required": ["issue"]
          },
          "result": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": ["title", "text"]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "startAgent": {
          "description": "Starts an agent session on an issue, in a checkout on a branch of its own.",
          "params": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          },
          "result": {}
        },
        "issues.upsertFromSource": {
          "description": "Issues the source has, created or updated here.",
          "params": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "description": "The source's id in projects.issueSources"
              },
              "repository": {
                "type": "string"
              },
              "repoSpace": {
                "type": ["string", "null"]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "external": {
                      "type": "string"
                    }
                  },
                  "required": ["external"],
                  "additionalProperties": {}
                }
              },
              "quiet": {
                "type": "boolean"
              }
            },
            "required": ["provider", "repository", "items"],
            "additionalProperties": {}
          },
          "result": {
            "type": "object",
            "properties": {
              "linked": {
                "type": "boolean"
              },
              "space": {
                "type": "string"
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "external": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
