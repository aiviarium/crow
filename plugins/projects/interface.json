              },
              "cycle": {
                "type": ["string", "null"]
              }
            },
            "required": ["issue"],
            "additionalProperties": {}
          },
          "result": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "state": {
                "type": ["string", "null"]
              },
              "category": {
                "type": ["string", "null"]
              },
              "priority": {
                "type": ["number", "null"]
              },
              "assignee": {
                "type": ["string", "null"]
              },
