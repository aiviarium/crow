  "events": {},
  "extensionPoints": [
    {
      "id": "projects.issueSources",
      "description": "Another tracker whose issues are Projects issues (GitHub, Linear, Jira): a project links to its repositories, and issues and comments sync both ways. The contributing plugin brings changes in through the projects service (issues.upsertFromSource, comments.upsertFromSource); Projects calls the `push` method of its service to write a change of an issue or a comment, as the person who made it, and `repositories` for what a project can be linked to.",
      "schema": {
        "type": "object",
        "required": ["id", "title", "service", "push"],
        "properties": {
          "id": {
            "type": "string",
            "description": "The provider: what `source.provider` of its issues says (`github`)."
          },
          "title": {
            "type": "string",
            "description": "The tracker's name, as in “Open on GitHub”."
          },
          "icon": {
            "type": "string",
            "description": "An icon of @crow/ui for its badge."
          },
          "service": {
            "type": "string"
          },
          "push": {
            "type": "string",
            "description": "Gets { link, issue, fields, create?, comment? } and returns what the source now has."
          },
          "repositories": {
            "type": "string",
            "description": "Gets { space } and returns { repositories: [{ repository, name, url, repoSpace, connection, linked? }] }."
          },
          "linked": {
            "type": "string",
            "description": "Gets { link } after a project was linked from its settings."
          },
          "unlinked": {
            "type": "string",
            "description": "Gets { link } after a link was removed."
          }
        }
      }
    }
  ],
