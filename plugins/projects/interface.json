                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "parent": {
                      "type": ["string", "null"]
                    },
                    "cycle": {
                      "type": ["string", "null"]
                    },
                    "due": {
                      "type": ["string", "null"]
