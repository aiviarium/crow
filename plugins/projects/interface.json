{
  "id": "projects",
  "version": "0.1.0",
  "services": {
    "projects": {
      "methods": {
        "createIssue": {
          "params": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "project": {
                "type": "string",
                "description": "Project key or space id; the current project by default"
              },
              "description": {
                "description": "Markdown",
                "type": "string"
              },
              "link": {
                "description": "The issue source link to create it through",
                "type": ["string", "null"]
              },
              "state": {
                "description": "State name",
                "type": "string"
              },
              "priority": {
                "description": "0 none, 1 urgent, 2 high, 3 medium, 4 low",
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "assignee": {
                "description": "user://… or \"me\"",
                "type": ["string", "null"]
              },
              "labels": {
                "description": "Label names or label:// URIs",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "estimate": {
                "type": ["number", "null"]
              },
              "due": {
                "type": ["string", "null"]
              },
              "parent": {
                "description": "The parent issue's key or URI",
                "type": ["string", "null"]
              },
              "cycle": {
                "type": ["string", "null"]
              }
            },
            "required": ["title"],
            "additionalProperties": {}
          },
          "result": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "state": {
                "type": ["string", "null"]
              },
              "category": {
                "type": ["string", "null"]
              },
              "priority": {
                "type": ["number", "null"]
              },
              "assignee": {
                "type": ["string", "null"]
              },
              "labels": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "parent": {
                "type": ["string", "null"]
              },
              "cycle": {
                "type": ["string", "null"]
              },
              "due": {
                "type": ["string", "null"]
              },
              "estimate": {
                "type": ["number", "null"]
              }
            },
            "required": ["uri", "key", "title"],
            "additionalProperties": {}
          }
        },
        "getIssue": {
          "params": {
            "type": "object",
