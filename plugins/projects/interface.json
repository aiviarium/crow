        "sources.find": {
          "description": "The Crow issue of a source's issue, by number or id at the source; null when none.",
          "params": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "description": "The source's id in projects.issueSources"
              },
              "repository": {
                "type": "string"
              },
              "repoSpace": {
                "type": ["string", "null"]
              },
              "number": {
                "type": "number"
              },
              "external": {
                "type": "string"
