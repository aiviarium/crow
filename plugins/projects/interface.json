              },
              "labels": {
                "description": "Label names or label:// URIs",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "estimate": {
                "type": ["number", "null"]
              },
              "due": {
                "type": ["string", "null"]
              },
              "parent": {
                "description": "The parent issue's key or URI",
