                "type": "string",
                "description": "Key (CROW-12) or URI (issue://…)"
              },
              "title": {
                "type": "string"
              },
              "state": {
                "description": "State name",
                "type": "string"
              },
              "priority": {
                "description": "0 none, 1 urgent, 2 high, 3 medium, 4 low",
