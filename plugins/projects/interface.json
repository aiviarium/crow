      "description": "A cycle of a project"
    },
    {
      "scheme": "label",
      "title": "Label",
      "icon": "tag",
      "view": "projects.label",
      "description": "An issue label"
    },
    {
      "scheme": "comment",
      "title": "Comment",
      "icon": "chat",
      "view": "projects.comment",
      "description": "A comment on an issue"
    },
    {
      "scheme": "issueview",
      "title": "Issue view",
      "icon": "filter",
