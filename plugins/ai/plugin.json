{
  "id": "ai",
  "name": "Models",
  "version": "0.1.0",
  "apiVersion": "1",
  "namespace": "ai",
  "description": "Model services: text generation and speech to text through connections to model APIs, tasks mapped to models per deployment, space and person, usage and limits. Other plugins add providers; callers use the `ai` service.",
  "client": "src/client.tsx",
  "styles": "src/client.css",
  "interface": "interface.ts",
  "provides": {
    "services": ["ai"]
  },
  "extensionPoints": [
    {
      "id": "ai.providers",
      "description": "A model API a plugin speaks: the connection type it serves, its tasks and models, and `service`, the plugin's service that implements generate (streamed), transcribe and models for it.",
      "schema": {
        "type": "object",
        "required": ["id", "title", "connectionType", "tasks", "service"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "connectionType": { "type": "string" },
          "tasks": {
            "type": "array",
            "items": { "enum": ["text", "fast", "transcription"] }
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "tasks": {
                  "type": "array",
                  "items": { "enum": ["text", "fast", "transcription"] }
                }
              }
            }
          },
          "detectsLanguage": { "type": "boolean" },
          "service": { "type": "string" }
        }
      }
    }
  ],
  "services": [
    {
      "id": "router",
      "title": "Model router",
      "provides": "ai",
      "endpoints": [
        {
          "name": "grpc",
          "kind": "grpc",
          "port": 9000
        }
      ],
      "dev": {
        "command": ["sh", "-c", "exec ${AI_ROUTER_BIN:-cargo run --quiet --manifest-path router/Cargo.toml}"]
      },
      "methods": "methods.json",
      "definitions": {
        "task": {
          "enum": ["text", "fast", "transcription"]
        },
        "scope": {
          "enum": ["global", "space", "user"]
        },
        "message": {
          "type": "object",
          "required": ["role", "content"],
          "properties": {
            "role": { "enum": ["user", "assistant"] },
            "content": { "type": "string" }
          }
        },
        "generateParams": {
          "type": "object",
          "required": ["task"],
          "properties": {
            "request": {
              "type": "string",
              "description": "The caller's id for the request, a UUID."
            },
            "task": { "$ref": "#/definitions/task" },
            "system": { "type": "string" },
            "messages": {
              "type": "array",
              "items": { "$ref": "#/definitions/message" }
            },
            "prompt": {
              "type": "string",
              "description": "A user message added after the messages."
            },
            "context": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Entity URIs, turned into text for the caller."
            },
            "schema": {
              "type": "object",
              "description": "A JSON Schema the answer must match."
            },
            "schemaName": { "type": "string" },
            "maxTokens": { "type": "integer", "minimum": 1 },
            "temperature": { "type": "number" },
            "plugin": {
              "type": "string",
              "description": "The plugin the request is for, for the usage report."
            },
            "space": { "type": "string" }
          }
        },
        "generated": {
          "type": "object",
          "required": ["request", "text", "model", "provider", "usage"],
          "properties": {
            "request": { "type": "string" },
            "text": { "type": "string" },
            "object": {},
            "model": { "type": "string" },
            "provider": { "type": "string" },
            "usage": { "$ref": "#/definitions/tokenUsage" }
          }
        },
        "transcribed": {
          "type": "object",
          "required": ["request", "text", "model", "provider"],
          "properties": {
            "request": { "type": "string" },
            "text": { "type": "string" },
            "language": { "type": "string" },
            "seconds": { "type": "number" },
            "model": { "type": "string" },
            "provider": { "type": "string" }
          }
        },
        "generateEvent": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "text"],
              "properties": {
                "type": { "const": "delta" },
                "text": { "type": "string" }
              }
            },
            {
              "type": "object",
              "required": ["type", "generated"],
              "properties": {
                "type": { "const": "done" },
                "generated": { "$ref": "#/definitions/generated" }
              }
            }
          ]
        },
        "dictateEvent": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "text"],
              "properties": {
                "type": { "const": "partial" },
                "text": { "type": "string" }
              }
            },
            {
              "type": "object",
              "required": ["type", "transcribed"],
              "properties": {
                "type": { "const": "transcribed" },
                "transcribed": { "$ref": "#/definitions/transcribed" }
              }
            }
          ]
        },
        "taskInfo": {
          "type": "object",
          "required": ["task", "available", "live", "detectsLanguage"],
          "properties": {
            "task": { "$ref": "#/definitions/task" },
            "available": { "type": "boolean" },
            "scope": { "$ref": "#/definitions/scope" },
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "destination": { "type": "string" },
            "live": { "type": "boolean" },
            "detectsLanguage": { "type": "boolean" }
          }
        },
        "modelInfo": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "tasks": {
              "type": "array",
              "items": { "$ref": "#/definitions/task" }
            }
          }
        },
        "providerInfo": {
          "type": "object",
          "required": ["id", "title", "connectionType", "tasks", "detectsLanguage"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "plugin": { "type": "string" },
            "connectionType": { "type": "string" },
            "tasks": {
              "type": "array",
              "items": { "$ref": "#/definitions/task" }
            },
            "detectsLanguage": { "type": "boolean" }
          }
        },
        "usageRow": {
          "type": "object",
          "required": ["key", "requests", "errors", "inputTokens", "outputTokens", "audioSeconds"],
          "properties": {
            "key": { "type": "string" },
            "label": { "type": "string" },
            "requests": { "type": "integer" },
            "errors": { "type": "integer" },
            "inputTokens": { "type": "integer" },
            "outputTokens": { "type": "integer" },
            "audioSeconds": { "type": "number" }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "requests": { "type": "integer", "minimum": 0 },
            "tokens": { "type": "integer", "minimum": 0 },
            "audioSeconds": { "type": "integer", "minimum": 0 }
          }
        },
        "limitsInfo": {
          "type": "object",
          "required": ["default", "users"],
          "properties": {
            "default": { "$ref": "#/definitions/limits" },
            "users": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["userId", "limits"],
                "properties": {
                  "userId": { "type": "string" },
                  "name": { "type": "string" },
                  "limits": { "$ref": "#/definitions/limits" }
                }
              }
            }
          }
        },
        "tokenUsage": {
          "type": "object",
          "properties": {
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "audioSeconds": { "type": "number", "minimum": 0 }
          }
        },
        "mappingInfo": {
          "type": "object",
          "required": [
            "task",
            "scope",
            "connection",
            "connectionName",
            "connectionType",
            "provider",
            "model",
            "live",
            "destination",
            "local",
            "updatedAt"
          ],
          "properties": {
            "task": { "$ref": "#/definitions/task" },
            "scope": { "$ref": "#/definitions/scope" },
            "spaceId": { "type": "string" },
            "userId": { "type": "string" },
            "connection": { "type": "string" },
            "connectionName": { "type": "string" },
            "connectionType": { "type": "string" },
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "live": { "type": "boolean" },
            "destination": { "type": "string" },
            "local": { "type": "boolean" },
            "updatedAt": { "type": "string" }
          }
        }
      }
    }
  ],
  "contributes": {
    "settings": [
      {
        "key": "ai.dictationLanguage",
        "title": "Dictation language",
        "category": "Dictation \u203a",
        "type": "string",
        "default": "auto",
        "scopes": ["user"]
      }
    ],
    "connectionTypes": [
      {
        "id": "ai.openai-compatible",
        "aliases": ["openai-compatible"],
        "title": "OpenAI-compatible API",
        "description": "A model API that speaks OpenAI's protocol: OpenAI itself, hosted providers that copy it, or a server of your own such as Ollama, llama.cpp or vLLM.",
        "icon": "sparkle",
        "fields": {
          "type": "object",
          "required": ["baseUrl"],
          "properties": {
            "baseUrl": {
              "type": "string",
              "title": "Base URL",
              "description": "The API's root, ending in /v1 for most servers.",
              "default": "https://api.openai.com/v1",
              "minLength": 1
            },
            "apiKey": {
              "type": "string",
              "title": "API key",
              "description": "Sent as a bearer token. Leave it empty for a server without one."
            },
            "headers": {
              "type": "string",
              "title": "Extra headers",
              "description": "One per line, as Name: value.",
              "x-multiline": true
            }
          }
        },
        "secret": ["apiKey"],
        "testHandler": {
          "service": "router",
          "method": "test"
        }
      }
    ],
    "collections": [
      {
        "name": "mappings",
        "scope": "global",
        "fields": [
          { "name": "key", "type": "text", "required": true, "unique": true },
          {
            "name": "task",
            "type": "enum",
            "values": ["text", "fast", "transcription"],
            "required": true,
            "index": true
          },
          {
            "name": "scope",
            "type": "enum",
            "values": ["global", "space", "user"],
            "required": true
          },
          { "name": "space", "type": "text" },
          { "name": "user", "type": "text" },
          { "name": "connection", "type": "text", "required": true },
          { "name": "model", "type": "text", "required": true },
          { "name": "live", "type": "boolean", "default": false }
        ]
      },
      {
        "name": "limits",
        "scope": "global",
        "fields": [
          { "name": "user", "type": "text", "required": true, "unique": true },
          { "name": "requests", "type": "integer", "min": 0 },
          { "name": "tokens", "type": "integer", "min": 0 },
          { "name": "audioSeconds", "type": "integer", "min": 0 }
        ]
      },
      {
        "name": "usage",
        "kind": "log",
        "scope": "global",
        "partition": "month",
        "fields": [
          { "name": "at", "type": "datetime", "required": true, "index": true },
          { "name": "user", "type": "text", "index": true },
          { "name": "principal", "type": "text", "required": true },
          { "name": "plugin", "type": "text", "required": true },
          {
            "name": "task",
            "type": "enum",
            "values": ["text", "fast", "transcription"],
            "required": true
          },
          { "name": "provider", "type": "text", "required": true },
          { "name": "model", "type": "text", "required": true },
          { "name": "connection", "type": "text" },
          { "name": "inputTokens", "type": "integer" },
          { "name": "outputTokens", "type": "integer" },
          { "name": "audioSeconds", "type": "number" },
          { "name": "ok", "type": "boolean", "required": true },
          { "name": "error", "type": "text" },
          { "name": "durationMs", "type": "integer" }
        ],
        "indexes": [["user", "at"]]
      }
    ],
    "rpc": [
      { "method": "tasks", "handler": { "service": "router", "method": "tasks" } },
      {
        "method": "generate",
        "stream": true,
        "timeoutSecs": 180,
        "handler": { "service": "router", "method": "generate" }
      },
      { "method": "complete", "handler": { "service": "router", "method": "complete" } },
      { "method": "transcribe", "handler": { "service": "router", "method": "transcribe" } },
      {
        "method": "dictate",
        "stream": true,
        "timeoutSecs": 300,
        "handler": { "service": "router", "method": "dictate" }
      },
      { "method": "dictateAudio", "handler": { "service": "router", "method": "dictateAudio" } },
      { "method": "mappings", "handler": { "service": "router", "method": "mappings" } },
      { "method": "setMapping", "handler": { "service": "router", "method": "setMapping" } },
      { "method": "removeMapping", "handler": { "service": "router", "method": "removeMapping" } },
      { "method": "providers", "handler": { "service": "router", "method": "providers" } },
      { "method": "models", "handler": { "service": "router", "method": "models" } },
      { "method": "usage", "handler": { "service": "router", "method": "usage" } },
      { "method": "limits", "handler": { "service": "router", "method": "limits" } },
      { "method": "setLimits", "handler": { "service": "router", "method": "setLimits" } }
    ],
    "views": [
      {
        "id": "ai.models",
        "title": "Models",
        "icon": "cpu",
        "slot": "main"
      }
    ],
    "routes": [{ "path": "", "view": "ai.models" }, { "path": "models", "view": "ai.models" }],
    "nav": [{ "id": "ai.models", "title": "Models", "view": "ai.models", "icon": "cpu" }],
    "commands": [{ "id": "ai.models", "title": "Open Models", "category": "Models" }],
    "adminPages": [
      {
        "id": "ai.models",
        "title": "Models",
        "icon": "cpu",
        "view": "ai.models",
        "rpc": ["usage", "limits", "setLimits"],
        "collections": ["mappings", "limits", "usage"]
      }
    ]
  }
}
