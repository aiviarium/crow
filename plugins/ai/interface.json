{
  "id": "ai",
  "version": "0.1.0",
  "services": {
    "ai": {
      "methods": {
        "tasks": {
          "description": "Which tasks the caller can use where they are, and where requests for each go.",
          "params": {
            "type": "object",
            "properties": {
              "space": {
                "type": "string"
              }
            }
          },
          "result": {
            "type": "object",
            "properties": {
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "task": {
                      "type": "string",
                      "enum": ["text", "fast", "transcription"]
                    },
                    "available": {
                      "type": "boolean"
                    },
                    "scope": {
                      "type": "string",
                      "enum": ["global", "space", "user"]
                    },
                    "provider": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    },
                    "destination": {
                      "type": "string"
                    },
                    "live": {
                      "type": "boolean"
                    },
                    "detectsLanguage": {
                      "type": "boolean"
                    }
                  },
                  "required": ["task", "available", "live", "detectsLanguage"]
                }
              }
            },
            "required": ["tasks"]
          }
        },
        "generate": {
          "description": "Text from the model mapped to a task, as it is written: `delta` events, then one `done` event with the whole answer. Leaving the stream cancels the request upstream.",
          "params": {
            "type": "object",
            "properties": {
              "request": {
                "description": "The caller's id for the request, a UUID",
                "type": "string"
              },
              "task": {
                "type": "string",
                "enum": ["text", "fast", "transcription"]
              },
              "system": {
                "type": "string"
              },
              "messages": {
                "description": "The conversation so far",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": ["user", "assistant"]
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "required": ["role", "content"]
                }
              },
              "prompt": {
                "description": "A user message added after the messages",
                "type": "string"
              },
              "context": {
                "description": "Entity URIs, turned into text for the caller and given to the model before the messages",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "schema": {
                "description": "A JSON Schema the answer must match",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "schemaName": {
                "type": "string"
              },
              "maxTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "temperature": {
                "type": "number"
              },
              "plugin": {
                "description": "The plugin the request is for, for the usage report",
                "type": "string"
              },
              "space": {
                "description": "The space whose mapping applies; the caller's current one by default",
                "type": "string"
              }
            },
            "required": ["task"]
          },
          "result": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "delta"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": ["type", "text"]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "done"
                  },
                  "generated": {
                    "type": "object",
                    "properties": {
                      "request": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      },
                      "object": {
                        "description": "With a schema: the parsed answer, checked against it"
                      },
                      "model": {
                        "type": "string"
                      },
                      "provider": {
                        "type": "string"
                      },
                      "usage": {
                        "type": "object",
                        "properties": {
                          "inputTokens": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "outputTokens": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "audioSeconds": {
                            "type": "number",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "required": ["request", "text", "model", "provider", "usage"]
                  }
                },
                "required": ["type", "generated"]
              }
            ]
          },
          "stream": true
        },
        "complete": {
          "description": "The whole answer at once; with a schema the checked object as well.",
          "params": {
            "type": "object",
            "properties": {
              "request": {
                "description": "The caller's id for the request, a UUID",
                "type": "string"
              },
              "task": {
                "type": "string",
                "enum": ["text", "fast", "transcription"]
              },
              "system": {
                "type": "string"
              },
              "messages": {
                "description": "The conversation so far",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": ["user", "assistant"]
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "required": ["role", "content"]
                }
              },
              "prompt": {
                "description": "A user message added after the messages",
                "type": "string"
              },
              "context": {
                "description": "Entity URIs, turned into text for the caller and given to the model before the messages",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "schema": {
                "description": "A JSON Schema the answer must match",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "schemaName": {
                "type": "string"
              },
              "maxTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "temperature": {
                "type": "number"
              },
              "plugin": {
                "description": "The plugin the request is for, for the usage report",
                "type": "string"
              },
              "space": {
                "description": "The space whose mapping applies; the caller's current one by default",
                "type": "string"
              }
            },
            "required": ["task"]
          },
          "result": {
            "type": "object",
            "properties": {
              "request": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "object": {
                "description": "With a schema: the parsed answer, checked against it"
              },
              "model": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "usage": {
                "type": "object",
                "properties": {
                  "inputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "outputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "audioSeconds": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "required": ["request", "text", "model", "provider", "usage"]
          }
        },
        "transcribe": {
          "description": "Speech to text of a whole clip.",
          "params": {
            "type": "object",
            "properties": {
              "audio": {
                "type": "string",
                "description": "The clip, base64"
              },
              "mime": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "language": {
                "type": "string"
              },
              "request": {
                "type": "string"
              },
              "plugin": {
                "type": "string"
              },
              "space": {
                "type": "string"
              }
            },
            "required": ["audio", "mime"]
          },
          "result": {
            "type": "object",
            "properties": {
              "request": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "seconds": {
                "type": "number"
              },
              "model": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              }
            },
            "required": ["request", "text", "model", "provider"]
          }
        }
      }
    }
  },
  "events": {},
  "extensionPoints": [
    {
      "id": "ai.providers",
      "description": "A model API a plugin speaks: the connection type it serves, its tasks and models, and `service`, the plugin's service that implements generate (streamed), transcribe and models for it.",
      "schema": {
        "type": "object",
        "required": ["id", "title", "connectionType", "tasks", "service"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "connectionType": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "enum": ["text", "fast", "transcription"]
            }
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "tasks": {
                  "type": "array",
                  "items": {
                    "enum": ["text", "fast", "transcription"]
                  }
                }
              }
            }
          },
          "detectsLanguage": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          }
        }
      }
    }
  ],
  "entityTypes": []
}
