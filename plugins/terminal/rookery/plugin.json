{
  "$schema": "https://github.com/aiviarium/rookery/blob/main/schemas/plugin.schema.json",
  "apiVersion": "1",
  "name": "Terminal",
  "description": "Terminals on any host: an xterm.js viewer, sessions per host, the bottom panel with tabs and a split, and the host's screen.",
  "client": "client/client.js",
  "styles": "client/client.css",
  "namespace": "terminal",
  "contributes": {
    "views": [
      {
        "id": "terminal.sessions",
        "title": "Terminals",
        "slot": "main",
        "icon": "terminal"
      },
      {
        "id": "terminal.session",
        "title": "Terminal",
        "slot": "main",
        "icon": "terminal"
      },
      {
        "id": "terminal.screen",
        "title": "Host screen",
        "slot": "main",
        "icon": "eye"
      },
      {
        "id": "terminal.panel",
        "title": "Terminals",
        "slot": "panel",
        "icon": "terminal"
      }
    ],
    "routes": [
      {
        "path": "/",
        "view": "terminal.sessions"
      },
      {
        "path": "/sessions/:env",
        "view": "terminal.sessions"
      },
      {
        "path": "/session/:id",
        "view": "terminal.session"
      },
      {
        "path": "/screen/:id",
        "view": "terminal.screen"
      },
      {
        "path": "/panel",
        "view": "terminal.panel"
      }
    ],
    "nav": [
      {
        "id": "terminal.nav",
        "title": "Terminals",
        "view": "terminal.sessions",
        "icon": "terminal"
      }
    ],
    "commands": [
      {
        "id": "terminal.new",
        "title": "New terminal",
        "category": "Terminal"
      },
      {
        "id": "terminal.sessions",
        "title": "Terminal sessions",
        "category": "Terminal"
      },
      {
        "id": "terminal.panel",
        "title": "Terminals in the panel",
        "category": "Terminal"
      }
    ],
    "keybindings": [
      {
        "command": "terminal.panel",
        "key": "mod+alt+t"
      }
    ],
    "collections": [],
    "settings": [],
    "adminPages": []
  }
}
