format 1

package {
  group crow
  id agents
  version "0.1.0"
}

about {
  name "Agents"
  summary "Agent sessions on hosts through Parrot: chat, tool steps, approvals, questions and artifacts."
  license MIT
  license Apache-2.0
  repository "https://github.com/aiviarium/crow"
  keywords rookery-plugin
}

targets {
  rookery {
    requires {
      rookery ">=0.6"
    }
  }
}
