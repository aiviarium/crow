format 1

package {
  group crow
  id model-anthropic
  version "0.1.0"
}

about {
  name "Anthropic models"
  summary "Anthropic's Messages API as a provider of the Models plugin, for the text and fast tasks with streaming and structured output."
  license MIT
  license Apache-2.0
  repository "https://github.com/aiviarium/crow"
  keywords rookery-plugin
}

targets {
  rookery {
    requires {
      rookery ">=0.6"
    }
  }
}
