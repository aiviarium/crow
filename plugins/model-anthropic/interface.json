{
  "id": "model-anthropic",
  "version": "0.1.0",
  "services": {
    "anthropic": {
      "methods": {
        "generate": {
          "description": "Text from the Messages API: `delta` chunks as it is written, then one `result`.",
          "params": {
            "type": "object",
            "properties": {
              "request": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "task": {
                "type": "string",
                "enum": ["text", "fast", "transcription"]
              },
              "connection": {
                "type": "string",
                "description": "The id of the connection to use"
              },
              "model": {
                "type": "string"
              },
              "system": {
                "type": "string"
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": ["user", "assistant"]
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "required": ["role", "content"]
                }
              },
              "schema": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "schemaName": {
                "type": "string"
              },
              "maxTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "temperature": {
                "type": "number"
              }
            },
            "required": ["request", "provider", "task", "connection", "messages"]
          },
          "result": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "delta"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": ["type", "text"]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "result"
                  },
                  "text": {
                    "type": "string"
                  },
                  "object": {},
                  "model": {
                    "type": "string"
                  },
                  "usage": {
                    "type": "object",
                    "properties": {
                      "inputTokens": {
                        "type": "number"
                      },
                      "outputTokens": {
                        "type": "number"
                      }
                    }
                  }
                },
                "required": ["type", "text"]
              }
            ]
          },
          "stream": true
        },
        "models": {
          "description": "The models the connection's key may use.",
          "params": {
            "type": "object",
            "properties": {
              "request": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "task": {
                "type": "string",
                "enum": ["text", "fast", "transcription"]
              },
              "connection": {
                "type": "string",
                "description": "The id of the connection to use"
              },
              "model": {
                "type": "string"
              },
              "system": {
                "type": "string"
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": ["user", "assistant"]
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "required": ["role", "content"]
                }
              },
              "schema": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "schemaName": {
                "type": "string"
              },
              "maxTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "temperature": {
                "type": "number"
              }
            },
            "required": ["request", "provider", "task", "connection", "messages"]
          },
          "result": {
            "type": "object",
            "properties": {
              "models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "tasks": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": ["text", "fast", "transcription"]
                      }
                    }
                  },
                  "required": ["id"]
                }
              }
            },
            "required": ["models"]
          }
        }
      }
    }
  },
  "events": {},
  "extensionPoints": [],
  "entityTypes": []
}
