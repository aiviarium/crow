{
  "name": "crow",
  "private": true,
  "type": "module",
  "workspaces": [
    "shell",
    "plugins/*"
  ],
  "scripts": {
    "sync-deps": "bun scripts/sync-deps.ts",
    "bootstrap": "bun run sync-deps && bun install",
    "dev": "bun run builtins && bun --cwd shell dev",
    "build": "bun run builtins && bun --cwd shell build",
    "lint": "biome ci shell plugins scripts",
    "format": "biome format --write shell plugins scripts",
    "typecheck": "bun run builtins && bun scripts/typecheck.ts",
    "test": "bun run builtins && bun test --timeout 30000 shell/test plugins",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "builtins": "bun scripts/builtins.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.4.12",
    "@happy-dom/global-registrator": "^20.14.6",
    "@types/bun": "^1.3.14",
    "babel-preset-solid": "^1.9.19",
    "solid-js": "^1.9.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-solid": "^2.11.16"
  }
}
